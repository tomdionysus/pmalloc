root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[test/vendor/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
